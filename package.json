{
  "name": "nisar-surface-change-monitor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "test": "pnpm --filter web test",
    "tauri": "pnpm --filter desktop tauri",
    "lint": "biome check apps/web/src apps/web/tests",
    "format": "biome format --write apps/web/src apps/web/tests",
    "lint:fix": "biome check --write apps/web/src apps/web/tests",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "video:dev": "pnpm --filter video dev",
    "video:render": "pnpm --filter video render",
    "r2:setup": "node scripts/r2/tiles.mjs setup",
    "r2:upload": "node scripts/r2/tiles.mjs upload",
    "r2:data": "node scripts/r2/tiles.mjs data",
    "r2:tiles": "node scripts/r2/tiles.mjs all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "wrangler": "^4.161.0"
  }
